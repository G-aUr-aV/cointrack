# Configure secrets in a private environment file outside the repository.
# MONGODB_URI is read by Node only; never prefix it with VITE_.
MONGODB_URI=mongodb+srv://DATABASE_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cointrack
PORT=4317
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4317
NODE_ENV=development
